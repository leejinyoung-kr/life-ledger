generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id         Int      @id @default(autoincrement())
  google_id  String   @unique @db.VarChar(100)
  email      String   @unique @db.VarChar(200)
  name       String   @db.VarChar(100)
  picture    String?  @db.VarChar(500)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  transactions Transaction[]
  savings      Saving[]
  investments  Investment[]

  @@map("user")
}

/// 거래 유형: income(수입) | expense(지출) | transfer(저축이동)
enum TransactionType {
  income
  expense
  transfer

  @@map("transaction_type")
}

/// 수입/지출 내역 (가계부 - 수입/지출 탭)
model Transaction {
  id             Int             @id @default(autoincrement())
  user_id        Int /// user.id FK
  type           TransactionType
  date           DateTime        @db.Date
  title          String          @db.VarChar(200)
  category       String          @db.VarChar(50)
  amount         Decimal         @db.Decimal(15, 2)
  pay_method     String          @db.VarChar(50)
  memo           String?         @db.VarChar(300)
  is_recurring   Boolean         @default(false)
  recurring_rule Json?
  deleted_at     DateTime?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, date])
  @@map("transaction")
}

/// 예적금 유형: savings(적금) | deposit(예금) | subscription(청약) | etc(기타)
enum SavingType {
  savings
  deposit
  subscription
  etc

  @@map("saving_type")
}

/// 예적금 (가계부 - 예적금 탭)
model Saving {
  id             Int        @id @default(autoincrement())
  user_id        Int /// user.id FK
  bank           String     @db.VarChar(100)
  name           String     @db.VarChar(100)
  type           SavingType
  interest_rate  Decimal    @db.Decimal(5, 2)
  monthly_amount Decimal    @db.Decimal(15, 2)
  start_date     DateTime   @db.Date
  maturity_date  DateTime?  @db.Date
  balance        Decimal    @db.Decimal(15, 2)
  memo           String?    @db.VarChar(300)
  deleted_at     DateTime?
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("saving")
}

/// 투자 유형: domestic_stock(국내주식) | foreign_stock(해외주식) | foreign_etf(해외ETF) | domestic_etf(국내ETF) | crypto(가상자산) | etc(기타)
enum InvestmentType {
  domestic_stock
  foreign_stock
  foreign_etf
  domestic_etf
  crypto
  etc

  @@map("investment_type")
}

/// 투자 (가계부 - 투자 탭)
model Investment {
  id            Int            @id @default(autoincrement())
  user_id       Int /// user.id FK
  name          String         @db.VarChar(100)
  type          InvestmentType
  principal     Decimal        @db.Decimal(15, 2)
  current_value Decimal        @db.Decimal(15, 2)
  purchase_date DateTime       @db.Date
  memo          String?        @db.VarChar(300)
  deleted_at    DateTime?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("investment")
}
