generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id         Int      @id @default(autoincrement())
  google_id  String?  @unique @db.VarChar(100) /// 구글 OAuth ID. 이메일 코드로만 생성된 계정은 null
  email      String   @unique @db.VarChar(200)
  name       String   @db.VarChar(100)
  picture    String?  @db.VarChar(500)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  transactions       Transaction[]
  savings            Saving[]
  investmentAccounts InvestmentAccount[]
  investments        Investment[]
  subscriptions      Subscription[]
  assets             Asset[]
  nwSnapshots        NetWorthSnapshot[]
  settings           UserSettings?
  notifications      Notification[]
  aiReports          AiReport[]
  aiUsageLogs        AiUsageLog[]
  calendarEvents     CalendarEvent[]
  securityRisks      SecurityRisk[]
  loginSessions      LoginSession[]
  identityCards      IdentityCard[]
  credentials        Credential[]
  envProjects        EnvProject[]
  envVars            EnvVar[]
  storageFolders     StorageFolder[]
  storageFiles       StorageFile[]
  accessLogs         AccessLog[]
  scoreSnapshots     SecurityScoreSnapshot[]
  pushSubscriptions  PushSubscription[]
  refreshTokens      RefreshToken[]
  recurringSchedules RecurringSchedule[]

  @@map("user")
}

/// 거래 유형: income(수입) | expense(지출) | transfer(저축이동)
enum TransactionType {
  income
  expense
  transfer

  @@map("transaction_type")
}

/// 자산이동(transfer) 누적 대상: saving(예적금) | investment(투자 예수금) | asset(부동산·부채)
enum TransferTarget {
  saving
  investment
  asset

  @@map("transfer_target")
}

/// 자산이동 대상 잔액 변화 방향: increase(증가) | decrease(감소). asset 대상 전용, 미지정 시 기존 동작
enum TransferDirection {
  increase
  decrease

  @@map("transfer_direction")
}

/// 수입/지출 내역 (가계부 - 수입/지출 탭)
model Transaction {
  id                    Int                @id @default(autoincrement())
  user_id               Int /// user.id FK
  type                  TransactionType
  date                  DateTime           @db.Date
  title                 String             @db.VarChar(200)
  category              String             @db.VarChar(50)
  amount                Decimal            @db.Decimal(15, 2)
  pay_method            String             @db.VarChar(50)
  memo                  String?            @db.VarChar(300)
  recurring_schedule_id Int? /// recurring_schedule.id FK (자동이체 설정으로 생성된 회차인 경우)
  recurring_period      String?            @db.VarChar(10) /// 반복 회차 식별 (YYYY-MM / YYYY / YYYY-MM-DD, recurring_schedule_id 있을 때만 사용)
  target_type           TransferTarget? /// 이동 대상 종류(transfer 전용) — 지정 시 대상 잔액에 자동 반영
  target_id             Int? /// 대상 테이블 id (target_type 기준, FK 아님)
  target_direction      TransferDirection? /// 잔액 변화 방향(asset 전용)
  deleted_at            DateTime?
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt

  user     User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  schedule RecurringSchedule? @relation(fields: [recurring_schedule_id], references: [id], onDelete: SetNull)

  @@index([user_id, date])
  @@index([recurring_schedule_id])
  @@map("transaction")
}

/// 예적금 유형: savings(적금) | deposit(예금) | subscription(청약) | etc(기타)
enum SavingType {
  savings
  deposit
  subscription
  etc

  @@map("saving_type")
}

/// 예적금 (가계부 - 예적금 탭)
model Saving {
  id             Int        @id @default(autoincrement())
  user_id        Int /// user.id FK
  bank           String     @db.VarChar(100)
  name           String     @db.VarChar(100)
  type           SavingType
  interest_rate  Decimal    @db.Decimal(5, 2)
  monthly_amount Decimal    @db.Decimal(15, 2)
  start_date     DateTime   @db.Date
  maturity_date  DateTime?  @db.Date
  balance        Decimal    @db.Decimal(15, 2)
  memo           String?    @db.VarChar(300)
  deleted_at     DateTime?
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("saving")
}

/// 투자 유형: domestic_stock(국내주식) | foreign_stock(해외주식) | foreign_etf(해외ETF) | domestic_etf(국내ETF) | crypto(가상자산) | etc(기타)
enum InvestmentType {
  domestic_stock
  foreign_stock
  foreign_etf
  domestic_etf
  crypto
  etc

  @@map("investment_type")
}

/// 투자 계좌 (가계부 - 투자 탭) — 예수금은 계좌 단위로 보유, 종목 여러 개가 한 계좌의 예수금을 공유(ISA 등)
model InvestmentAccount {
  id                 Int       @id @default(autoincrement())
  user_id            Int /// user.id FK
  name               String    @db.VarChar(100) /// 계좌명 (예: ISA, 일반위탁)
  cash_balance       Decimal   @default(0) @db.Decimal(15, 2) /// 원화 예수금(미투자 대기 현금) — 자산이동으로 충전, 매수/매도로 보유 종목과 전환
  cash_balance_usd   Decimal   @default(0) @db.Decimal(15, 2) /// 달러 예수금 — 환전(원화↔달러)으로만 증감, 해외주식 매수 재원
  account_number_enc String?   @db.VarChar(255) /// 계좌번호(암호문, AES-256-GCM) — 동일 계좌명(예: 일반위탁) 다중 보유 시 구분용
  memo               String?   @db.VarChar(300)
  deleted_at         DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  investments Investment[]

  @@index([user_id])
  @@map("investment_account")
}

/// 투자 종목 (가계부 - 투자 탭) — 투자 계좌에 속함
model Investment {
  id                Int            @id @default(autoincrement())
  user_id           Int /// user.id FK
  account_id        Int /// investment_account.id FK
  name              String         @db.VarChar(100)
  type              InvestmentType
  symbol            String?        @db.VarChar(20) /// 시세조회용 종목코드(국내) 또는 티커(해외)
  quantity          Decimal?       @db.Decimal(18, 6) /// 보유수량 — 시세조회 시 평가금액 계산에 사용
  principal         Decimal        @db.Decimal(15, 2)
  principal_usd     Decimal?       @db.Decimal(15, 4) /// 해외종목 달러 원금 (국내종목 null)
  current_value     Decimal        @db.Decimal(15, 2)
  current_value_usd Decimal?       @db.Decimal(15, 4) /// 해외종목 달러 평가금액 (국내종목 null)
  purchase_date     DateTime?      @db.Date
  memo              String?        @db.VarChar(300)
  deleted_at        DateTime?
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  user      User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account   InvestmentAccount   @relation(fields: [account_id], references: [id], onDelete: Cascade)
  schedules RecurringSchedule[]

  @@index([user_id])
  @@index([account_id])
  @@map("investment")
}

/// 반복 자동 생성 대상: transaction(거래) | investment(반복매수)
enum RecurringKind {
  transaction
  investment

  @@map("recurring_kind")
}

/// 반복 자동 생성 설정(자동이체) — 거래(kind=transaction)/반복매수(kind=investment) 공용.
/// 데이터(거래/투자)는 여기서 정의한 규칙에 따라 크론이 순수 생성만 한다 — 등록 폼과 완전히 분리.
model RecurringSchedule {
  id          Int           @id @default(autoincrement())
  user_id     Int /// user.id FK
  kind        RecurringKind /// 대상 종류
  rule        Json /// 반복 규칙 {cycle, day, month?, weekendAdjust?}
  start_date  DateTime      @db.Date /// 최초 실행 기준일
  last_period String?       @db.VarChar(10) /// 마지막 처리 회차(중복 생성 방지)
  active      Boolean       @default(true) /// 일시정지 여부

  tx_type          TransactionType? /// kind=transaction 전용
  title            String?            @db.VarChar(200) /// kind=transaction 전용
  category         String?            @db.VarChar(50) /// kind=transaction 전용
  amount           Decimal?           @db.Decimal(15, 2) /// kind=transaction 전용
  pay_method       String?            @db.VarChar(50) /// kind=transaction 전용
  memo             String?            @db.VarChar(300) /// kind=transaction 전용
  target_type      TransferTarget? /// kind=transaction 전용 — 이동 대상 종류(transfer)
  target_id        Int? /// kind=transaction 전용 — 대상 테이블 id
  target_direction TransferDirection? /// kind=transaction 전용 — 잔액 변화 방향(asset 전용)

  investment_id Int? /// investment.id FK — kind=investment 전용, 반복매수 대상 종목
  buy_amount    Decimal? @db.Decimal(15, 2) /// kind=investment 전용 — 회차당 매수금액(국내: 원, 해외: 달러)
  buy_quantity  Decimal? @db.Decimal(18, 6) /// kind=investment 전용 — 회차당 매수수량(주)

  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user        User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  investment  Investment?   @relation(fields: [investment_id], references: [id], onDelete: Cascade)
  occurrences Transaction[]

  @@index([user_id])
  @@index([investment_id])
  @@map("recurring_schedule")
}

/// 결제 주기: monthly(매월) | yearly(매년) | weekly(매주)
enum SubscriptionCycle {
  monthly
  yearly
  weekly

  @@map("subscription_cycle")
}

/// 구독 상태: active(활성) | trial(체험) | paused(일시정지)
enum SubscriptionStatus {
  active
  trial
  paused

  @@map("subscription_status")
}

/// 구독 (구독 관리 페이지) — 정기 결제 서비스
model Subscription {
  id                Int                @id @default(autoincrement())
  user_id           Int /// user.id FK
  name              String             @db.VarChar(100)
  category          String             @db.VarChar(50)
  amount            Decimal            @db.Decimal(15, 2)
  cycle             SubscriptionCycle  @default(monthly)
  status            SubscriptionStatus @default(active)
  next_payment_date DateTime           @db.Date
  pay_method        String             @db.VarChar(50)
  last_used_at      DateTime?          @db.Date
  memo              String?            @db.VarChar(300)
  deleted_at        DateTime?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("subscription")
}

/// 자산 유형: cash(현금성) | savings(예적금) | investment(투자) | realestate(부동산) | debt(부채) | etc(기타)
enum AssetType {
  cash
  savings
  investment
  realestate
  debt
  etc

  @@map("asset_type")
}

/// 자산/부채 (자산 종합 페이지) — debt 는 부채로 순자산에서 차감
model Asset {
  id            Int       @id @default(autoincrement())
  user_id       Int /// user.id FK
  type          AssetType
  name          String    @db.VarChar(100)
  amount        Decimal   @db.Decimal(15, 2)
  interest_rate Decimal?  @db.Decimal(5, 2)
  memo          String?   @db.VarChar(300)
  deleted_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("asset")
}

/// 순자산 월별 스냅샷 (자산 종합 - 추이 차트용)
model NetWorthSnapshot {
  id           Int      @id @default(autoincrement())
  user_id      Int /// user.id FK
  month        String   @db.VarChar(7) /// YYYY-MM
  total_assets Decimal  @db.Decimal(15, 2)
  total_debt   Decimal  @db.Decimal(15, 2)
  created_at   DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, month])
  @@index([user_id])
  @@map("net_worth_snapshot")
}

/// 사용자 설정 (설정 페이지) — 1:1. 알림/보안/API/예산/카테고리/위젯 선호값
model UserSettings {
  id                  Int      @id @default(autoincrement())
  user_id             Int      @unique /// user.id FK
  display_name        String?  @db.VarChar(100)
  notif_monthly       Boolean  @default(true)
  notif_upload        Boolean  @default(false)
  notif_maturity      Boolean  @default(true) /// 예적금/구독 만기·결제 임박 알림 수신
  notif_deadline      Boolean  @default(true) /// 신원 만료·할일 마감 임박 알림 수신
  show_holidays       Boolean  @default(true) /// 캘린더에 공휴일·대체공휴일 표시 여부
  session_expiry      String   @default("7d") @db.VarChar(10) /// 7d|1d|12h|none
  pw_auto_hide        String   @default("10s") @db.VarChar(10) /// 10s|30s|1m|none
  openai_api_key      String?  @db.VarChar(512) /// OpenAI API 키 (AI 리포트 생성, AES-256-GCM 암호문 'v1:...')
  openai_model        String   @default("gpt-4o-mini") @db.VarChar(50) /// AI 리포트 생성 모델
  master_lock_enabled Boolean  @default(false) /// 보관함 마스터 잠금 사용 여부 (Google 로그인 외 2차 잠금)
  master_lock_hash    String?  @db.VarChar(200) /// 마스터 비번 해시 (scrypt: saltHex:hashHex)
  master_lock_timeout Int      @default(5) /// 자동잠금 시간(분). 0=수동 잠금만
  categories          Json /// [{emoji, name}]
  widgets             Json /// [{id, on}] (배열 순서 = 표시 순서)
  menu_order          Json? /// 사이드바 1차 메뉴 순서 (key 배열). null=기본순서
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// 알림 그룹: ledger(가계부) | system(시스템)
enum NotiGroup {
  ledger
  system

  @@map("noti_group")
}

/// 알림 톤(중요도/색): warning(주의) | success(완료) | info(일반)
enum NotiTone {
  warning
  success
  info

  @@map("noti_tone")
}

/// 알림 (알림 페이지)
model Notification {
  id          Int       @id @default(autoincrement())
  user_id     Int /// user.id FK
  group       NotiGroup
  tone        NotiTone
  title       String    @db.VarChar(200)
  description String    @db.VarChar(500)
  source      String    @db.VarChar(50) /// 발생처 라벨(가계부/AI 리포트/계정 보관함 등)
  read_at     DateTime? /// 읽은 시각, null=안읽음
  occurred_at DateTime  @default(now()) /// 알림 발생 시각(화면 표시용)
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("notification")
}

/// AI 리포트 (가계부 데이터 분석 - 소비 패턴·절약 인사이트)
model AiReport {
  id           Int      @id @default(autoincrement())
  user_id      Int /// user.id FK
  period_label String   @db.VarChar(50) /// 분석 기간 표시 라벨 (예: "2026년 5월", "최근 3개월")
  period_from  DateTime @db.Date /// 분석 시작일
  period_to    DateTime @db.Date /// 분석 종료일
  model_used   String   @db.VarChar(50) /// 생성에 사용한 AI 모델
  summary      String   @db.VarChar(1000) /// 종합 요약 (총지출·증감 등)
  insights     Json /// [{tone: green|warning|danger, text}]
  tags         Json /// 키워드 태그 목록
  created_at   DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("ai_report")
}

model AiUsageLog {
  id                Int      @id @default(autoincrement())
  user_id           Int /// user.id FK
  model             String   @db.VarChar(50) /// 호출에 사용한 OpenAI 모델
  source            String   @db.VarChar(20) /// 호출 출처: parse(거래파싱) | report(리포트)
  prompt_tokens     Int /// 입력 토큰 수
  completion_tokens Int /// 출력 토큰 수
  total_tokens      Int /// 총 토큰 수
  cost_usd          Decimal  @db.Decimal(10, 6) /// 비용(USD) — 호출 시점 모델 단가로 산정
  created_at        DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("ai_usage_log")
}

/// 일정 유형: pay(구독 결제) | due(입금/만기) | exp(서류 만료) | task(할일)
enum CalEventType {
  pay
  due
  exp
  task

  @@map("cal_event_type")
}

/// 반복 주기: none(반복 없음) | weekly | monthly | yearly
enum CalRecurFreq {
  none
  weekly
  monthly
  yearly

  @@map("cal_recur_freq")
}

/// 캘린더 일정 (캘린더 페이지)
model CalendarEvent {
  id          Int          @id @default(autoincrement())
  user_id     Int /// user.id FK
  date        DateTime     @db.Date
  type        CalEventType
  title       String       @db.VarChar(200)
  memo        String?      @db.VarChar(300)
  is_lunar    Boolean      @default(false) /// 음력 날짜 여부 (true면 lunar_month/lunar_day가 기준)
  lunar_month Int?         /// 음력 월 (is_lunar=true일 때만 사용)
  lunar_day   Int?         /// 음력 일
  lunar_leap  Boolean      @default(false) /// 윤달 여부
  recur_freq  CalRecurFreq @default(none)
  recur_until DateTime?    @db.Date /// 반복 종료일 (null = 무기한)
  deleted_at  DateTime?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, date])
  @@map("calendar_event")
}

/// 공휴일·대체공휴일 (전 사용자 공용 캐시 — 공공데이터포털 특일 정보 API에서 연 단위로 가져와 저장)
model Holiday {
  id            Int      @id @default(autoincrement())
  date          DateTime @db.Date /// 공휴일 날짜
  name          String   @db.VarChar(100) /// 공휴일명 (대체공휴일은 원본 명칭 그대로, is_substitute로 구분)
  is_substitute Boolean  @default(false) /// 대체공휴일 여부
  year          Int /// 조회 연도(solYear 기준, 캐시 갱신 단위)
  created_at    DateTime @default(now())

  @@unique([date, name])
  @@index([year])
  @@map("holiday")
}

/// 위험 종류: reuse(재사용) | weak(취약) | no2fa(2FA 미설정) | breach(유출 의심)
enum SecurityRiskCategory {
  reuse
  weak
  no2fa
  breach

  @@map("security_risk_category")
}

/// 위험 심각도: critical(심각) | danger(위험) | warning(주의) | info(권장)
enum SecurityRiskSeverity {
  critical
  danger
  warning
  info

  @@map("security_risk_severity")
}

/// 보안 위험 요소 (보안 센터 - 위험 요소)
model SecurityRisk {
  id           Int                  @id @default(autoincrement())
  user_id      Int /// user.id FK
  category     SecurityRiskCategory
  severity     SecurityRiskSeverity
  title        String               @db.VarChar(200)
  description  String               @db.VarChar(300)
  action_label String               @db.VarChar(20) /// 처리 버튼 라벨(변경/분리/강화/설정)
  resolved     Boolean              @default(false)
  resolved_at  DateTime?
  created_at   DateTime             @default(now())
  updated_at   DateTime             @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("security_risk")
}

/// 기기 종류: desktop | mobile | unknown
enum SessionDeviceType {
  desktop
  mobile
  unknown

  @@map("session_device_type")
}

/// 세션 상태: active(정상) | unverified(미확인)
enum SessionStatus {
  active
  unverified

  @@map("session_status")
}

/// 카테고리 도메인: transaction(가계부) | subscription(구독) | asset(자산) | investment(투자) | saving(예적금) | pay_method(결제수단) | credential_cat(계정 카테고리) | id_type(신원지갑 종류) | env_group(ENV 그룹)
enum CategoryDomain {
  transaction
  subscription
  asset
  investment
  saving
  pay_method
  bank
  credential_cat
  id_type
  env_group

  @@map("category_domain")
}

/// 카테고리 (설정 > 카테고리 관리) — 도메인별 사용자 정의 카테고리
// 전역 공용 분류표 (user 무관). 모든 사용자가 동일 카테고리 세트를 공유·편집
model Category {
  id          Int            @id @default(autoincrement())
  domain      CategoryDomain
  code        String         @db.VarChar(50)
  label       String         @db.VarChar(100)
  parent_code String?        @db.VarChar(50) /// 대분류 code (소분류만 채움, 대분류·단일계층 도메인은 NULL)
  sort_order  Int            @default(1) @map("sort_order")
  is_active   Boolean        @default(true) @map("is_active")
  created_by  Int? /// 생성자 user.id (감사용, FK 아님 — 유저 삭제와 무관하게 보존)
  created_at  DateTime       @default(now()) @map("created_at")
  updated_at  DateTime       @updatedAt @map("updated_at")

  @@unique([domain, code])
  @@index([domain])
  @@index([domain, parent_code])
  @@map("category")
}

/// 로그인 세션 (보안 센터 - 로그인 기기/세션)
model LoginSession {
  id             Int               @id @default(autoincrement())
  user_id        Int /// user.id FK
  device         String            @db.VarChar(100)
  device_type    SessionDeviceType @default(unknown)
  location       String            @db.VarChar(100)
  is_current     Boolean           @default(false)
  status         SessionStatus     @default(active)
  last_active_at DateTime          @default(now())
  revoked_at     DateTime? /// 로그아웃/차단 시각, null=활성
  created_at     DateTime          @default(now())

  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([user_id])
  @@map("login_session")
}

/// 갱신 토큰 화이트리스트 — refresh 발급 시 jti 기록, rotation/로그아웃/세션revoke 시 폐기
model RefreshToken {
  id         Int       @id @default(autoincrement())
  user_id    Int /// user.id FK
  session_id Int? /// login_session.id FK
  jti        String    @unique @db.VarChar(36)
  expires_at DateTime /// 만료일(KST)
  revoked_at DateTime? /// 폐기일(KST), null=유효
  created_at DateTime  @default(now()) /// 발급일(KST)

  user    User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  session LoginSession? @relation(fields: [session_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([session_id])
  @@map("refresh_token")
}

/// 이메일 코드 로그인 — 구글 로그인 불가 환경용 대체 인증. 6자리 코드 해시를 보관(평문 미저장), 5분 만료
model EmailLoginCode {
  id          Int       @id @default(autoincrement())
  email       String    @db.VarChar(200) /// 수신 이메일(화이트리스트와 대조)
  code_hash   String    @db.VarChar(100) /// 코드 SHA-256 해시
  expires_at  DateTime /// 만료 시각
  consumed_at DateTime? /// 사용/무효화 시각, null=유효
  attempts    Int       @default(0) /// 검증 시도 횟수(무차별 대입 차단)
  created_at  DateTime  @default(now())

  @@index([email])
  @@map("email_login_code")
}

/// 신원 문서 종류: passport(여권) | idcard(주민등록증) | license(운전면허) | cert(자격증) | etc(기타)
enum IdentityType {
  passport
  idcard
  license
  cert
  etc

  @@map("identity_type")
}

/// 신원 지갑 (신원 지갑 페이지) — 문서 번호는 AES-256-GCM 암호화 저장
model IdentityCard {
  id          Int          @id @default(autoincrement())
  user_id     Int /// user.id FK
  type        IdentityType
  name        String       @db.VarChar(100)
  number_enc  String       @db.Text /// 문서 번호(암호문)
  file_id     Int? /// storage_file.id FK — 사본 이미지(여권/신분증 스캔)
  issue_date  DateTime?    @db.Date
  expire_date DateTime?    @db.Date
  memo        String?      @db.VarChar(300)
  deleted_at  DateTime?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  user User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  file StorageFile? @relation(fields: [file_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@map("identity_card")
}

/// 계정 보관함 (계정 보관함 페이지) — 비밀번호·TOTP 는 AES-256-GCM 암호화 저장
model Credential {
  id                  Int       @id @default(autoincrement())
  user_id             Int /// user.id FK
  name                String    @db.VarChar(100)
  url                 String?   @db.VarChar(300)
  category            String    @db.VarChar(50)
  username            String    @db.VarChar(200)
  password_enc        String    @db.Text /// 비밀번호(암호문)
  totp_enc            String?   @db.Text /// 2FA TOTP 시크릿(암호문)
  backup_codes_enc    String?   @db.Text /// 2FA 백업코드 목록(JSON 배열 암호문)
  password_changed_at DateTime? /// 비밀번호 마지막 변경 시각(KST) — 90일 회전 알림용
  memo                String?   @db.VarChar(300)
  deleted_at          DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("credential")
}

/// ENV 환경 종류: dev(development) | prod(production)
enum EnvKind {
  dev
  prod

  @@map("env_kind")
}

/// ENV 프로젝트 (ENV 보관함 페이지) — 환경변수 묶음 단위
model EnvProject {
  id          Int       @id @default(autoincrement())
  user_id     Int /// user.id FK
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(300)
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vars EnvVar[]

  @@index([user_id])
  @@map("env_project")
}

/// 파일 보관함 폴더 — parent_id 로 무한 중첩 지원
model StorageFolder {
  id         Int       @id @default(autoincrement())
  user_id    Int /// user.id FK
  parent_id  Int? /// storage_folder.id FK (null = 루트)
  name       String    @db.VarChar(200)
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user     User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent   StorageFolder?  @relation("FolderTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children StorageFolder[] @relation("FolderTree")
  files    StorageFile[]

  @@index([user_id])
  @@index([parent_id])
  @@map("storage_folder")
}

/// 파일 보관함 파일 메타데이터 — B2 오브젝트 키 + 크기·MIME 저장
model StorageFile {
  id         Int       @id @default(autoincrement())
  user_id    Int /// user.id FK
  folder_id  Int? /// storage_folder.id FK
  object_key String    @db.VarChar(500) /// B2 오브젝트 키 (users/{userId}/{uuid}/{filename})
  name       String    @db.VarChar(300) /// 원본 파일명
  size       BigInt    @default(0) /// 바이트 단위
  mime_type  String    @db.VarChar(100)
  hash       String?   @db.VarChar(64) /// SHA-256 (동일 내용 중복 업로드 제거용)
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  folder        StorageFolder? @relation(fields: [folder_id], references: [id], onDelete: SetNull)
  identityCards IdentityCard[]

  @@index([user_id])
  @@index([folder_id])
  @@index([user_id, hash])
  @@map("storage_file")
}

/// ENV 변수 (ENV 보관함 페이지) — 값(value)은 AES-256-GCM 암호화 저장
model EnvVar {
  id         Int       @id @default(autoincrement())
  user_id    Int /// user.id FK
  project_id Int /// env_project.id FK
  env        EnvKind
  group      String?   @db.VarChar(50)
  location   String?   @db.VarChar(150) /// env 파일 위치 (예: backend/.env, frontend/.env.local)
  key        String    @db.VarChar(150)
  value_enc  String    @db.Text /// 값(암호문)
  memo       String?   @db.VarChar(300)
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user    User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project EnvProject      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  history EnvVarHistory[]

  @@index([user_id])
  @@index([project_id, env])
  @@map("env_var")
}

/// ENV 변수 값 변경 이력 (버전이력/롤백) — 값 변경 시 이전 암호문을 1건씩 적재
model EnvVarHistory {
  id         Int      @id @default(autoincrement())
  env_var_id Int /// env_var.id FK
  user_id    Int /// user.id FK (소유자 확인용)
  value_enc  String   @db.Text /// 이전 값(암호문)
  created_at DateTime @default(now())

  envVar EnvVar @relation(fields: [env_var_id], references: [id], onDelete: Cascade)

  @@index([env_var_id, created_at])
  @@map("env_var_history")
}

/// 보관함 열람 동작: cred_reveal(계정 비번/2FA) | cred_totp(TOTP 코드) | cred_backup(백업코드) | identity_reveal(신원번호) | env_reveal(ENV 값)
/// | backup_codes_generate(백업코드 생성) | vault_unlock(보관함 잠금해제) | vault_disable(보관함 잠금 해제설정)
/// | session_revoke(세션 강제로그아웃) | data_export(전체 데이터 export)
enum AccessAction {
  cred_reveal
  cred_totp
  cred_backup
  identity_reveal
  env_reveal
  backup_codes_generate
  vault_unlock
  vault_disable
  session_revoke
  data_export

  @@map("access_action")
}

/// 보관함 접근 감사 로그 (보안 센터 - 최근 열람) — 민감정보 복호화 호출의 주체·시각·대상 기록
model AccessLog {
  id          Int          @id @default(autoincrement())
  user_id     Int /// user.id FK
  action      AccessAction
  target_type String       @db.VarChar(20) /// 대상 종류 (credential|identity|env|security|account)
  target_id   Int /// 대상 레코드 id
  target_name String       @db.VarChar(200) /// 대상 표시명(열람 시점 스냅샷)
  ip          String?      @db.VarChar(60)
  user_agent  String?      @db.VarChar(300)
  created_at  DateTime     @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("access_log")
}

/// 보안 점수 일별 스냅샷 (보안 센터 - 점수 추이 차트) — 크론이 매일 1건 적재
model SecurityScoreSnapshot {
  id         Int      @id @default(autoincrement())
  user_id    Int /// user.id FK
  date       String   @db.VarChar(10) /// YYYY-MM-DD (KST 기준 1일 1건)
  score      Int /// 보안 점수 0~100
  reuse      Int      @default(0) /// 재사용 비밀번호 건수
  weak       Int      @default(0) /// 취약 비밀번호 건수
  no2fa      Int      @default(0) /// 2FA 미설정 건수
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date])
  @@index([user_id])
  @@map("security_score_snapshot")
}

/// 시스템 로그 — 크론/반복매수/AI 등 백그라운드 작업의 실행 기록. 90일 경과 시 자동 삭제
model SystemLog {
  id         Int      @id @default(autoincrement())
  user_id    Int? /// 관련 사용자 (크론 전체 집계 등 전역 이벤트는 null)
  level      String   @db.VarChar(10) /// info | warn | error
  category   String   @db.VarChar(30) /// recurring_buy | recurring_tx | cron | asset | file | security | ai
  message    String   @db.Text
  metadata   Json? /// 추가 컨텍스트 (symbol, amount, error 등)
  created_at DateTime @default(now())

  @@index([level])
  @@index([category])
  @@index([created_at])
  @@index([user_id])
  @@map("system_log")
}

/// 웹 푸시 구독 (PWA Web Push - 브라우저 푸시 서비스 endpoint + 암복호화 키)
model PushSubscription {
  id         Int      @id @default(autoincrement())
  user_id    Int /// user.id FK
  endpoint   String   @unique @db.VarChar(500) /// 브라우저 푸시 서비스 엔드포인트 URL
  p256dh     String   @db.VarChar(255) /// 페이로드 암호화용 공개키(Base64URL)
  auth       String   @db.VarChar(255) /// 페이로드 인증 시크릿(Base64URL)
  user_agent String?  @db.VarChar(300) /// 구독 생성 기기 식별용(선택)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("push_subscription")
}
