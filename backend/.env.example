# 부팅 시 src/config/env.ts 스키마로 검증한다 — 틀린 키가 있으면 전부 출력하고 부팅 중단.
# 키를 추가·삭제하면 env.ts 와 이 파일을 같이 고친다(src/config/env.spec.ts 가 두 목록이 같은지 검사)

# ============================
# 내부 연동
# ============================

# App
PORT=8000
# 운영은 https://lifeledger.tailba78c1.ts.net — CORS_ORIGINS 도 같은 값, GOOGLE_CALLBACK_URL 은 이 주소 + /api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000
# 콤마 구분, 비우면 http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database — infra 레포의 공용 MariaDB(호스트 13306)에 전용 사용자 docnexus 로. 비밀번호는 infra/.env 의 DOCNEXUS_DB_PASSWORD
# (docker compose 로 띄우면 compose 가 호스트를 mariadb 로 덮는다)
DATABASE_URL="mysql://docnexus:password@localhost:13306/docnexus?timezone=+09:00"
# DB 백업(매일 04시) 저장 경로 — 비우면 <실행 경로>/backups
BACKUP_DIR=

# 리버스 프록시 뒤에서 운영 시 — x-forwarded-for 신뢰 홉 수(숫자) 또는 'true'/CIDR. 미설정 시 비활성
TRUST_PROXY=

# 빌드된 커밋 — .env 에 적지 않는다. 배포(docker compose build --build-arg)가 이미지에 넣고 /_meta 가 보여준다
GIT_COMMIT=

# JWT — 용도별로 서로 다른 32자 이상 랜덤값 (예: openssl rand -hex 32). 같거나 아래 예시값 그대로면 부팅 실패
# access 토큰(보호 API)
JWT_SECRET=your_super_secret_jwt_key_change_this
# refresh 토큰(httpOnly 쿠키) — 바꾸면 모든 기기가 한 번 다시 로그인
JWT_REFRESH_SECRET=your_refresh_jwt_secret_change_this
# 보관함 잠금해제 토큰(x-vault-token) — 바꾸면 보관함이 다시 잠김
JWT_VAULT_SECRET=your_vault_jwt_secret_change_this

# 보관함 암호화 키 (AES-256-GCM) — 계정 비밀번호·신원 번호·ENV 값 등. 필수
#   <키ID>:<시크릿> 콤마 구분. 첫 번째 키로 암호화하고 나머지는 복호화만 한다
#   키ID 는 영문 소문자·숫자(예: 만든 연월 k2609), 시크릿은 32자 이상 랜덤값: echo "k$(date +%y%m):$(openssl rand -hex 32)"
#   이 값을 잃으면 보관함 데이터를 복구할 수 없다 — 비밀번호 관리자 등 서버 밖에도 보관할 것
#   교체: 새 키를 맨 앞에 추가 → 배포(부팅 시 자동 재암호화) → 이전 키 제거 → 배포 (남은 이전 키 암호문이 있으면 배포 전 점검이 막는다)
CRYPTO_KEYS=k2609:change_this_to_openssl_rand_hex_32_output
# 이전 포맷(v1) 암호문을 읽는 옛 키 — 새로 설치하면 비워 둔다.
#   기존 데이터가 있으면 재암호화가 끝날 때까지 두었다가 비운다(v1 이 남아 있으면 배포 전 점검·부팅이 막는다)
CREDENTIAL_SECRET=

# ============================
# 외부 연동
# ============================

# Google OAuth2 (필수)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# 로그인 허용 이메일(콤마 구분, 필수) — 비우면 부팅 실패. 목록 밖 계정은 구글·이메일 코드 로그인 모두 거부
ALLOWED_EMAILS=you@example.com

# 파일 보관함 (Backblaze B2, S3 호환, 필수)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_BUCKET_REGION=
B2_ENDPOINT=

# 공휴일·대체공휴일 (공공데이터포털 특일 정보 API — data.go.kr에서 발급). 비우면 캘린더 공휴일 표시 비활성
HOLIDAY_API_KEY=

# 웹 푸시 (VAPID) — 둘 다 비우면 푸시 발송 비활성(앱 내 알림은 정상 동작). 하나만 있으면 부팅 실패
# VAPID_SUBJECT는 실제 도메인 메일/URL이어야 함 — 가짜 도메인(.local 등)이면
# Apple 푸시 게이트웨이(web.push.apple.com)가 JWT를 BadJwtToken으로 거부함
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-real-email@example.com

# SMTP 메일 발송 — HOST·USER·PASS 를 모두 비우면 메일 발송 비활성(no-op). 일부만 있으면 부팅 실패
# 이메일 코드 로그인 등에 사용. Gmail 예: SMTP_HOST=smtp.gmail.com / PORT=587 / USER=계정 / PASS=앱비밀번호(16자리)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LifeLedger <no-reply@life-ledger.local>

# 데모 인스턴스 — 'true' 일 때만 데모 로그인 라우트(POST /auth/demo)가 등록되고, 계정 삭제 · 마스터 잠금 변경을 막는다.
# 운영 인스턴스에서는 비워 둔다(라우트 자체가 없다). 매일 초기화는 `pnpm demo:reset` (이 값이 true 가 아니면 실행 거부)
DEMO_MODE=
# 사용자별 파일 저장 한도(MB) — 비우면 한도 없음. 데모 인스턴스에서 B2 용량을 묶는 데 쓴다
STORAGE_QUOTA_MB=
