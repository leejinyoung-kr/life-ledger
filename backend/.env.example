# db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=docnexus
PORT=8000
DATABASE_URL="mysql://root:password@localhost:3306/docnexus"

# google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this

# 보관함 암호화 (AES-256-GCM) — 계정 비밀번호·신원 번호·ENV 값 암호화 키
CREDENTIAL_SECRET=change_this_to_a_long_random_secret

# App
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# 파일 보관함 (Cloudflare R2 — 미구현, Phase 18). S3 호환
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# AI (Claude API — 미구현, Phase 20/21). 사용자별 키는 설정에서 입력·DB 저장하며,
# 서버 공용 폴백이 필요할 때만 사용
CLAUDE_API_KEY=
