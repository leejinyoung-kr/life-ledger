# ============================
# 내부 연동
# ============================

# App
PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=docnexus
DATABASE_URL="mysql://root:password@localhost:3306/docnexus"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this

# 암호화 (AES-256-GCM) — 계정 비밀번호·신원 번호·ENV 값 암호화 키
CREDENTIAL_SECRET=change_this_to_a_long_random_secret

# ============================
# 외부 연동
# ============================

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# 로그인 허용 이메일(콤마 구분) — 비우면 모든 구글 계정 허용. 개인 서비스는 본인 이메일만
ALLOWED_EMAILS=swlsdud100559@gmail.com

B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_BUCKET_REGION=
B2_ENDPOINT=

# 파일 보관함 (Cloudflare R2 / S3 호환 — 미구현, Phase 18)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# AI (OpenAI — 미구현)
OPENAI_API_KEY=

# 웹 푸시 (VAPID) — 비우면 푸시 발송 비활성(앱 내 알림은 정상 동작)
# 키 생성: cd backend && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@docnexus.local