# docker-compose 전용 — DB 는 infra 레포의 공용 MariaDB 에 전용 사용자 docnexus 로 붙는다
# infra/.env 의 DOCNEXUS_DB_PASSWORD 와 같은 값 (backend/.env 의 DATABASE_URL 비밀번호도 같게)
DB_PASSWORD=change_this_to_infra_docnexus_db_password

# frontend 빌드 시점에 브라우저 코드에 박히는 백엔드 주소 (Next.js NEXT_PUBLIC_*)
# backend/.env 의 FRONTEND_URL/CORS_ORIGINS 와 같은 호스트 기준으로, 포트만 8000으로
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# 위와 같은 호스트:포트 + /api/v1 (앱 전체 API 호출에 사용됨)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
