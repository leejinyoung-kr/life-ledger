# docker-compose 전용 — DB 는 infra 레포의 공용 MariaDB 에 전용 사용자 lifeledger 로 붙는다
# infra/.env 의 LIFELEDGER_DB_PASSWORD 와 같은 값 (backend/.env 의 DATABASE_URL 비밀번호도 같게)
DB_PASSWORD=change_this_to_infra_lifeledger_db_password

# frontend 빌드 시점에 브라우저 코드에 박히는 백엔드 주소 (Next.js NEXT_PUBLIC_*)
# 로컬은 backend/.env 의 FRONTEND_URL/CORS_ORIGINS 와 같은 호스트에 포트만 8000으로.
# 운영은 화면과 API 가 같은 주소다 (Tailscale 이 / 는 frontend, /api 는 backend 로 보낸다)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# 위와 같은 호스트:포트 + /api/v1 (앱 전체 API 호출에 사용됨)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── 홈서버만 — 로컬에서는 비워 둔다 ──
# 운영 주소는 https://lifeledger.tailba78c1.ts.net (위 두 값도 이 주소로 — /api/v1 은 뒤에 붙인다)
# Tailscale 사이드카를 켠다
# COMPOSE_PROFILES=homeserver
# Tailscale 관리 화면에서 만든 tag:app 인증 키 — 처음 붙을 때만 쓰고, 붙은 뒤에는 지워도 된다
# TS_AUTHKEY=
