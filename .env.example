# docker-compose 전용 — MariaDB 컨테이너 root 비밀번호
# backend/.env 의 DB_PASSWORD / DATABASE_URL 과 동일한 값으로 맞춰야 함
MARIADB_ROOT_PASSWORD=change_this_to_a_strong_password

# frontend 빌드 시점에 브라우저 코드에 박히는 백엔드 주소 (Next.js NEXT_PUBLIC_*)
# backend/.env 의 FRONTEND_URL/CORS_ORIGINS 와 같은 호스트 기준으로, 포트만 8000으로
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
